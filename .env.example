# Optional configuration for live subscription scans (azmigrate-check --subscription env).
# Copy to .env or export in your shell. Never commit real values.

# Subscription to scan
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Authentication: the simplest option is `az login` (Azure CLI), which needs nothing here.
# For CI/service principals, DefaultAzureCredential also reads these variables:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
